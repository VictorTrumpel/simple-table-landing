---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import TableDemo from '../components/TableDemo';
import UseCases from '../components/UseCases';
import HistoryPreview from '../components/HistoryPreview';

const appUrl = (import.meta.env.PUBLIC_APP_URL || 'https://simple-table.ru').replace(/\/$/, '');
const registrationUrl = `${appUrl}/registration`;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf9f7" />
    <meta name="description" content="SimpleTable — рабочие таблицы для вашей команды. Ведите заявки и реестры вместе, отслеживайте историю изменений и управляйте доступом. Импорт Excel и CSV." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content="SimpleTable — вся команда в курсе" />
    <meta property="og:description" content="Общие таблицы, история каждого изменения и понятные роли. Рабочие данные под контролем вашей команды." />
    <meta property="og:image" content="/social-cover.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SimpleTable — одна таблица, вся команда в курсе" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>SimpleTable — рабочие таблицы для вашей команды</title>
  </head>
  <body>
    <a href="#main" class="skip-link">Перейти к содержимому</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="#" aria-label="SimpleTable — на главную"><span class="brand-mark"><Icon name="table" size={22} /></span><span>Simple<span class="brand-light">Table</span></span></a>
        <nav class="desktop-nav" aria-label="Основная навигация"><a href="#features">Возможности</a><a href="#use-cases">Для вашей команды</a><a href="#how-to-start">Как начать</a></nav>
        <div class="header-actions"><a href={appUrl} class="login-link">Войти <Icon name="diagonal" size={15} /></a><a class="button button-small button-dark" href={registrationUrl}>Начать работу <Icon size={16} /></a></div>
        <button class="mobile-menu-toggle" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="mobile-navigation"><Icon name="menu" /></button>
      </div>
      <nav id="mobile-navigation" class="mobile-nav" aria-label="Мобильная навигация" hidden><a href="#features">Возможности</a><a href="#use-cases">Для вашей команды</a><a href="#how-to-start">Как начать</a><a href={appUrl}>Войти в SimpleTable ↗</a><a href={registrationUrl}>Начать работу →</a></nav>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="container hero-content">
          <a class="announcement" href="#demo"><span class="live-dot"></span> Для тех, кто работает вместе <span class="announcement-arrow">↗</span></a>
          <h1 id="hero-title">Одна таблица.<br />Вся команда <span class="highlight-word">в курсе.<svg viewBox="0 0 350 18" fill="none" aria-hidden="true"><path d="M4 12c86-9 223-14 341-5M20 16c109-8 211-10 307-7" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></svg></span></h1>
          <p class="hero-description">Ведите заявки и рабочие реестры вместе.<br class="desktop-break" /> Видите изменения, проверяйте историю и управляйте доступом.</p>
          <div class="hero-actions"><a class="button button-purple" href={registrationUrl}>Начать работу <Icon size={19} /></a><a class="button button-outline" href="#demo"><Icon name="play" size={17} /> Посмотреть в деле</a></div>
          <div class="hero-note"><Icon name="upload" size={14} /> Начните со своей таблицы Excel или CSV</div>
          <div id="demo" class="hero-demo-wrap">
            <div class="demo-side-note" aria-hidden="true">Всё знакомо.<br />Теперь — вместе.<svg viewBox="0 0 100 58" fill="none"><path d="M2 3c11 37 49 32 86 36m-13-9 15 10-17 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
            <TableDemo client:load />
          </div>
          <p class="demo-instruction"><span class="instruction-pointer">↖</span> Попробуйте на примере. <strong>Нажмите на любую ячейку</strong>, откройте «Графики» или измените роли в «Участниках».<span class="demo-local-note"> Данные сбросятся при обновлении страницы.</span></p>
        </div>
        <div class="container benefits-strip"><span><Icon name="users" size={18} /> Совместная работа</span><span><Icon name="clock" size={18} /> История изменений</span><span><Icon name="shield" size={18} /> Понятные права доступа</span><span><Icon name="file" size={18} /> Импорт и экспорт</span></div>
      </section>

      <section id="use-cases" class="section use-cases" aria-labelledby="cases-title"><div class="container"><div class="section-heading"><span class="eyebrow"><span class="section-index">01 /</span> ЗНАКОМЫЕ ЗАДАЧИ</span><h2 id="cases-title">Ваши процессы.<br /><span class="text-muted">В понятной таблице.</span></h2><p>Соберите рабочие данные в одном месте.<br />Структуру таблицы задаёте вы.</p></div><UseCases client:visible /></div></section>

      <section id="features" class="section collaboration" aria-labelledby="collaboration-title"><div class="container feature-split"><div class="feature-copy"><span class="eyebrow"><span class="section-index">02 /</span> СОВМЕСТНАЯ РАБОТА</span><h2 id="collaboration-title">Работаете вместе.<br /><span class="text-muted">Видите одно и то же.</span></h2><p>Сотрудник меняет статус заявки — команда видит обновление в таблице. А отметка у ячейки показывает, кто сейчас с ней работает.</p><ul class="check-list"><li><Icon name="check" size={16} /> Изменения передаются в реальном времени</li><li><Icon name="check" size={16} /> Действия коллег видны прямо в таблице</li></ul><a class="text-link" href="#demo">Попробовать на примере <Icon size={18} /></a></div><div class="collab-visual" aria-label="Пример: Анна меняет статус заявки, Михаил видит обновление"><div class="visual-grid" aria-hidden="true"></div><div class="person-label label-anna"><span class="avatar purple">АК</span> Анна редактирует <span class="pulse-dot" /></div><div class="collab-table"><div class="mini-table-heading"><Icon name="table" size={17} /> Заявки <span>Общая таблица</span></div><div class="collab-table-row header-row"><span>Заявка</span><span>Статус</span></div><div class="collab-table-row"><span>Настроить рабочие места</span><span class="app-peer-cell">В работе<code class="app-peer-email">anna@example.com</code></span></div><div class="collab-table-row"><span>Заменить картриджи</span><span>Готово</span></div><div class="collab-table-row"><span>Подключить оборудование</span><span>Новая</span></div></div><div class="sync-notification"><span class="notification-check"><Icon name="check" size={17} /></span><span><strong>Статус обновлён</strong><small>Михаил уже видит изменение</small></span><span class="avatar peach">МС</span></div><span class="visual-caption">Одна актуальная таблица для всех</span></div></div></section>

      <section id="history" class="section history-section" aria-labelledby="history-title"><div class="container feature-split reverse"><div class="history-visual"><HistoryPreview client:load /><div class="history-sticky"><Icon name="spark" size={18} /><span>У каждой цифры<br />есть своя история.</span></div></div><div class="feature-copy"><span class="eyebrow"><span class="section-index">03 /</span> ПРОЗРАЧНОСТЬ</span><h2 id="history-title">«А кто <br />это поменял?»<br /><span class="text-muted">Ответ уже здесь.</span></h2><p>У каждого изменения есть автор, время и предыдущее значение. Откройте историю таблицы или отдельной ячейки, чтобы разобраться в деталях.</p><div class="history-detail-tags"><span>Кто изменил</span><span>Когда</span><span>Что было раньше</span></div></div></div></section>

      <section id="order" class="section order-section" aria-labelledby="order-title"><div class="container"><div class="section-heading centered"><span class="eyebrow"><span class="section-index">04 /</span> ПОРЯДОК В ДАННЫХ</span><h2 id="order-title">Свобода в работе.<br /><span class="text-muted">Порядок в деталях.</span></h2><p>Задайте структуру данных и распределите доступ в команде.</p></div><div class="order-grid"><article class="order-card"><span class="icon-tile"><Icon name="table" size={22} /></span><h3>Каждому значению — свой тип</h3><p>Числа, текст, даты и выбор из списка.<br />Данные проще заполнять и проверять.</p><div class="column-settings"><div class="settings-label">НАСТРОЙКИ КОЛОНКИ</div><div class="settings-row"><span>Название</span><strong>Статус заявки</strong></div><div class="settings-row"><span>Тип данных</span><strong class="type-choice">Выбор из списка <Icon name="chevron" size={14} /></strong></div><div class="app-enum-options"><span>Новая</span><span>В работе</span><span>Готово</span></div><div class="settings-hint"><Icon name="check" size={14} /> Единые варианты для всей команды</div></div></article><article class="order-card"><span class="icon-tile green-tile"><Icon name="shield" size={22} /></span><h3>У каждого — своя роль</h3><p>Определите, кто управляет базой, кто<br class="desktop-break" /> вносит данные, а кто просматривает.</p><div class="roles-list"><div><span class="avatar purple">АК</span><span class="role-person"><strong>Анна Козлова</strong><small>Управляет базой и участниками</small></span><span class="role-badge admin">Администратор</span></div><div><span class="avatar peach">МС</span><span class="role-person"><strong>Михаил Смирнов</strong><small>Добавляет и изменяет данные</small></span><span class="role-badge">Редактор</span></div><div><span class="avatar green">ДВ</span><span class="role-person"><strong>Денис Волков</strong><small>Просматривает данные</small></span><span class="role-badge">Читатель</span></div></div></article></div></div></section>

      <section id="analytics" class="section analytics-section" aria-labelledby="analytics-title"><div class="container feature-split"><div class="feature-copy"><span class="eyebrow"><span class="section-index">05 /</span> ВИЗУАЛИЗАЦИЯ</span><h2 id="analytics-title">От строк <br /><span class="text-muted">к общей картине.</span></h2><p>Постройте график на основе колонок таблицы. Посмотрите, сколько заявок в работе и сколько уже выполнено. Сохраните настройки для следующего просмотра.</p><span class="subtle-note"><Icon name="chart" size={18} /> Данные и графики в одном пространстве</span></div><div class="chart-card"><div class="chart-card-heading"><div><span class="chart-eyebrow">РЕЕСТР ЗАЯВОК</span><h3>Как идут дела у команды</h3></div><span class="chart-icon"><Icon name="chart" size={20} /></span></div><div class="chart-toolbar"><span><span class="saved-dot" /> Пример данных</span><div class="chart-switch" role="group" aria-label="Вид графика"><button type="button" class="active" data-chart-view="bars" aria-pressed="true">Столбцы</button><button type="button" data-chart-view="donut" aria-pressed="false">Круговая</button></div></div><div class="chart-plot" id="chart-bars" role="img" aria-label="Пять заявок: две новые, две в работе, одна готова"><div class="chart-grid-lines"><span>3</span><span>2</span><span>1</span><span>0</span></div><div class="bars"><div class="bar-column"><span class="bar-value">2</span><div class="bar bar-new" style="--bar-height: 62%"></div><span class="bar-label">Новые</span></div><div class="bar-column"><span class="bar-value">2</span><div class="bar bar-progress" style="--bar-height: 62%"></div><span class="bar-label">В работе</span></div><div class="bar-column"><span class="bar-value">1</span><div class="bar bar-done" style="--bar-height: 31%"></div><span class="bar-label">Готово</span></div></div></div><div class="donut-view" id="chart-donut" hidden><div class="donut" role="img" aria-label="Новые — 40%, в работе — 40%, готово — 20%"><span><strong>5</strong>заявок</span></div><div class="donut-legend"><span><i class="legend-new"></i>Новые<strong>2</strong></span><span><i class="legend-progress"></i>В работе<strong>2</strong></span><span><i class="legend-done"></i>Готово<strong>1</strong></span></div></div><div class="chart-bottom">Та же таблица. Другой взгляд на данные.<Icon name="diagonal" size={16} /></div></div></div></section>

      <section id="how-to-start" class="section start-section" aria-labelledby="start-title"><div class="container"><div class="section-heading centered"><span class="eyebrow"><span class="section-index">06 /</span> ПРОСТОЙ СТАРТ</span><h2 id="start-title">Ваша таблица уже есть?<br /><span class="text-muted">Начните с неё.</span></h2></div><div class="steps"><article class="step"><div class="step-top"><span class="step-number">01</span><Icon name="upload" size={23} /></div><h3>Загрузите Excel или CSV</h3><p>Перенесите существующий реестр<br />или создайте пустую таблицу.</p></article><article class="step"><div class="step-top"><span class="step-number">02</span><Icon name="table" size={23} /></div><h3>Настройте колонки</h3><p>Выберите типы данных<br />и задайте варианты для списков.</p></article><article class="step"><div class="step-top"><span class="step-number">03</span><Icon name="users" size={23} /></div><h3>Добавьте команду</h3><p>Назначьте роли участникам<br />и начните работать вместе.</p></article></div><div class="export-note"><Icon name="download" size={17} /><p>Ваши данные остаются с вами. <strong>Таблицу можно выгрузить в Excel.</strong></p></div><div class="final-cta"><div class="cta-pattern" aria-hidden="true"></div><span class="cta-tag"><span></span> SIMPLETABLE</span><h2>Всё начинается <br />с одной таблицы.</h2><p>Соберите данные. Добавьте команду. Работайте вместе.</p><a href={registrationUrl} class="button button-dark">Начать работу <Icon size={19} /></a><span class="cta-footnote">Привычный формат. Общая работа. Понятные изменения.</span><div class="cta-decoration decoration-one" aria-hidden="true"><Icon name="table" size={34} /></div><div class="cta-decoration decoration-two" aria-hidden="true"><Icon name="check" size={30} /></div></div></div></section>
    </main>

    <footer class="site-footer"><div class="container footer-top"><a class="brand" href="#" aria-label="SimpleTable — на главную"><span class="brand-mark"><Icon name="table" size={21} /></span><span>Simple<span class="brand-light">Table</span></span></a><span class="footer-tagline">Рабочие таблицы. Понятная совместная работа.</span><a href={appUrl} class="text-link">Открыть SimpleTable <Icon name="diagonal" size={16} /></a></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} SimpleTable</span><a href="#main">Наверх ↑</a></div></footer>

    <script>
      const menuToggle = document.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
      const menu = document.querySelector<HTMLElement>('#mobile-navigation');
      function closeMenu() {
        if (!menuToggle || !menu) return;
        menu.hidden = true;
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.setAttribute('aria-label', 'Открыть меню');
      }
      menuToggle?.addEventListener('click', () => {
        if (!menu) return;
        const open = menuToggle.getAttribute('aria-expanded') !== 'true';
        menuToggle.setAttribute('aria-expanded', String(open));
        menuToggle.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
        menu.hidden = !open;
      });
      menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menuToggle?.getAttribute('aria-expanded') === 'true') { closeMenu(); menuToggle.focus(); }
      });
      document.addEventListener('click', (event) => {
        if (event.target instanceof Node && !menu?.contains(event.target) && !menuToggle?.contains(event.target)) closeMenu();
      });
      window.matchMedia('(min-width: 761px)').addEventListener('change', (event) => { if (event.matches) closeMenu(); });
      document.querySelectorAll<HTMLButtonElement>('[data-chart-view]').forEach((button) => button.addEventListener('click', () => {
        const bars = document.querySelector<HTMLElement>('#chart-bars');
        const donut = document.querySelector<HTMLElement>('#chart-donut');
        const showBars = button.dataset.chartView === 'bars';
        if (bars) bars.hidden = !showBars;
        if (donut) donut.hidden = showBars;
        document.querySelectorAll<HTMLButtonElement>('[data-chart-view]').forEach((item) => {
          const active = item === button;
          item.classList.toggle('active', active);
          item.setAttribute('aria-pressed', String(active));
        });
      }));
    </script>
  </body>
</html>
